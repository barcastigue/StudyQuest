# Copy to .env and fill in real values locally. NEVER commit .env.

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/studyquest

# Auth
JWT_SECRET=change-me

# File uploads
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads

# Quiz generation (LLM provider)
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name

# Email (certificate submission, optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
